<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_obsidian"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Zion"
            android:src="@drawable/widget_logo_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZION"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#a1a1aa"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_streak"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="🔥 1d"
            android:textColor="#f59e0b"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_progress_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_pill_accent"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="0%"
            android:textColor="#c7d2fe"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Habit Items List (Interactive RemoteViews) -->
    <LinearLayout
        android:id="@+id/widget_habits_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Habit 1 -->
        <LinearLayout
            android:id="@+id/widget_habit_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_item_bg"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/widget_habit_1_check"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Check"
                android:src="@drawable/widget_check_undone" />

            <TextView
                android:id="@+id/widget_habit_1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Habit 1"
                android:textColor="#f4f4f6"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Habit 2 -->
        <LinearLayout
            android:id="@+id/widget_habit_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_item_bg"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/widget_habit_2_check"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Check"
                android:src="@drawable/widget_check_undone" />

            <TextView
                android:id="@+id/widget_habit_2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Habit 2"
                android:textColor="#f4f4f6"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Habit 3 -->
        <LinearLayout
            android:id="@+id/widget_habit_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_item_bg"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/widget_habit_3_check"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Check"
                android:src="@drawable/widget_check_undone" />

            <TextView
                android:id="@+id/widget_habit_3_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Habit 3"
                android:textColor="#f4f4f6"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Habit 4 -->
        <LinearLayout
            android:id="@+id/widget_habit_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_item_bg"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/widget_habit_4_check"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Check"
                android:src="@drawable/widget_check_undone" />

            <TextView
                android:id="@+id/widget_habit_4_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Habit 4"
                android:textColor="#f4f4f6"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty State Message -->
        <TextView
            android:id="@+id/widget_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="All protocols complete today ✦"
            android:textColor="#71717a"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom Actions Toolbar -->
    <LinearLayout
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_open"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:text="Open Zion"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_add"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:text="+ Habit"
            android:textColor="#a5b4fc"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_focus"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:text="⚡ Focus"
            android:textColor="#34d399"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
