{
  "name": "zion",
  "version": "1.0.0",
  "description": "Zion - Premium Habit Tracker desktop application developed by Satyanarayana",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --outdir=dist-electron --external:electron --external:better-sqlite3",
    "dev": "npm run dev:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --outdir=dist-electron --external:electron --external:better-sqlite3",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "build:web": "vite build",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "dist": "npm run build && electron-builder --publish never",
    "test": "vitest run"
  },
  "keywords": [
    "habit-tracker",
    "electron",
    "react",
    "fitness"
  ],
  "author": {
    "name": "Satyanarayana"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.satyanarayana.zion",
    "productName": "Zion",
    "copyright": "Copyright © 2026 Satyanarayana. All rights reserved.",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "generic",
      "url": "https://example.com"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "legalTrademarks": "Zion Habit Tracker by Satyanarayana",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zion",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "uninstallDisplayName": "Zion - Habit Tracker by Satyanarayana",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
